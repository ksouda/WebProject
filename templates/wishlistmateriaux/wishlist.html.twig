{% extends '/FrontOffice/HomePage/base.html.twig' %}

{% block title %}Ma Wishlist{% endblock %}

{% block body %}
<style>
    .wishlist-container {
    margin-top: 50px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

.flip-card {
    width: 300px;
    height: 400px;
    margin: 10px;
    perspective: 1000px; /* Needed for 3D effect */
}

.flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s; /* Smooth flip transition */
    transform-style: preserve-3d;
}

.flip-card:hover .flip-card-inner {
    transform: rotateY(180deg); /* Rotate on hover */
}

.flip-card-front, .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden; /* Hide the back when flipped */
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px; /* Add some padding */
    box-sizing: border-box;
}

.flip-card-front {
    background-color: #f1f1f1; /* Light grey background */
    border: 1px solid #ccc;
    flex-direction: column;
    text-align: center;
}

.flip-card-back {
    background-color: #f1f1f1; /* Same background as the front */
    color: #333; /* Darker text color for better readability */
    transform: rotateY(180deg); /* Flip back side */
    flex-direction: column;
    text-align: center;
}

.flip-card img {
    width: 100%;
    height: auto;
    border-radius: 5px;
    margin-bottom: 10px; /* Space below image */
}

.flip-card h5, .flip-card p {
    margin: 5px 0; /* Add margin to separate text */
    color: #333; /* Ensure text is clearly visible */
}

.flip-card-back h5, .flip-card-back p {
    color: #333; /* Ensure text is clearly visible */
}

</style>


    <h1>Ma Wishlist</h1>
    <div class="wishlist-container">
        {% if wishlist %}
            <ul style="list-style-type: none; padding: 0;">
                {% for materiel in wishlist.idMateriel %}
                    <div class="flip-card">
                    <div class="flip-card-inner">
                        <!-- Front of the card -->
                        <div class="flip-card-front">
                            <img src="{{ asset('img/masonry-portfolio/' ~ materiel.photo) }}" alt="{{ materiel.nomMateriel }}">
                            <div>
                                <h5>{{ materiel.nomMateriel }}</h5>
                                <p>Quantité: {{ materiel.quantiteStock }}</p>
                            </div>
                        </div>
                        <!-- Back of the card -->
                        <div class="flip-card-back">
                            <h5>{{ materiel.nomMateriel }}</h5>
                            <p>Description: {{ materiel.description }}</p>
                            <p>Prix: {{ materiel.prixUnitaire }} TND</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucun matériel dans votre wishlist.</p>
        {% endif %}
    </div>
{% endblock %}

