<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('materiauxChart').getContext('2d');

        // Données des matériaux
        const labels = {{ labels|json_encode()|raw }}; // Noms des matériaux
        const data = {{ data|json_encode()|raw }}; // Quantités des matériaux

        // Définition des couleurs homogènes et plus cohérentes
        const backgroundColors = data.map(quantity => 
            quantity < 5 ? 'rgba(255, 60, 0, 0.7)' : 'rgba(2, 12, 87, 0.7)'); // Utilisation des couleurs pour insuffisant et suffisant

        const materiauxChart = new Chart(ctx, {
            type: 'pie', // Graphique circulaire
            data: {
                labels: labels.map((label, index) => label.length > 12 ? label.substring(0, 12) + '...' : label), // Afficher uniquement les noms des matériaux
                datasets: [{
                    label: 'Quantité en Stock',
                    data: data,
                    backgroundColor: backgroundColors, // Couleurs homogènes
                    borderColor: '#fff', // Bordure blanche pour contraste
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top', // Position de la légende
                        labels: {
                            font: {
                                size: 14, // Taille de police homogène pour la légende
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(tooltipItem) {
                                return tooltipItem.label + ': ' + tooltipItem.raw + ' unités'; // Afficher les quantités
                            }
                        }
                    },
                    title: {
                        display: true,
                        text: 'Répartition des Matériaux en Stock'
                    }
                },
                cutoutPercentage: 70, // Augmenter l'espace central pour améliorer l'affichage des labels
            }
        });
    });
</script>

