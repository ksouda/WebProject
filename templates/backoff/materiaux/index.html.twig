<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        let alerts = {{ app.flashes('alert')|json_encode|raw }}; // Récupérer tous les messages flash en tableau JS

        if (alerts.length > 0) {
            alerts.forEach((message, index) => {
                setTimeout(() => {
                    Swal.fire({
                        title: "Alerte Stock Faible",
                        text: message,
                        icon: "warning",
                        confirmButtonText: "OK",
                        timer: 5000
                    });
                }, index * 3000); // Décaler chaque pop-up pour éviter qu'elles se superposent
            });
        }
    });
</script>


