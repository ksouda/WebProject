<!DOCTYPE html>

<title>Atelierenligne</title>

{% block body %}
    <h1>Atelierenligne</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ atelierenligne.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ atelierenligne.titre }}</td>
